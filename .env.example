# Per-machine overrides for bin/gssg-run. Copy to .env.local (gitignored) and edit.
# Everything here is optional; gssg-run works with none of it set.

# Conda env to auto-activate if not already active.
#GSSG_CONDA_ENV=gssg

# Model checkpoints (FastSAM / MobileCLIP / YOLOE). Default: <repo>/checkpoints
#GSSG_CHECKPOINTS=/path/to/checkpoints

# Extra ROS 2 workspace overlay, sourced after /opt/ros/<distro> (e.g. the ZED wrapper).
#GSSG_ROS_WS=~/ros2_ws/install

# Explicit conda profile script, only if `conda` is not on PATH.
#GSSG_CONDA_SH=~/miniconda3/etc/profile.d/conda.sh

# LLM agent for the ATLAS dashboard (visualization/server.py)
#ANTHROPIC_API_KEY=
