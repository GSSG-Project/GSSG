# ---------------------------
# IDE / Editor
# ---------------------------
.vscode/
.idea/
debug_crops/
# ---------------------------
# Python
# ---------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.ipynb_checkpoints/
venv/
.venv/

# ---------------------------
# Data / Output / Temp
# ---------------------------
data/
output/
outputs/
temp/
checkpoints/
# TensorRT engines are device-specific build artifacts
*.plan
# ...but the web viewer has a SOURCE module dir literally named data/ — keep it tracked.
!visualization/web/src/data/
!visualization/web/src/data/*

# ---------------------------
# Build / Install / Compiled Files
# ---------------------------
build/
lib/
install/
*.so
*.o
*.a

# ---------------------------
# Third-Party Libraries / Large Files
# ---------------------------
gssg.egg-info
thirdparty/cuda-utils/build
thirdparty/cuda-utils/cuda_utils.egg-info
thirdparty/cuda-utils/cuda_utils/*.so
thirdparty/gaussian-rasterizer/build
thirdparty/gaussian-rasterizer/diff_gaussian_rasterization_depth.egg-info
thirdparty/simple-knn/build
thirdparty/simple-knn/simple_knn.egg-info
thirdparty/simple-knn/simple_knn/*.so
thirdparty/pytorch3d/build
thirdparty/bestsam/

# ---------------------------
# Jupyter Notebooks
# ---------------------------
*.ipynb

# ---------------------------
# Miscellaneous / System
# ---------------------------
.DS_Store
*.log
*.ply

# ---------------------------
# Secrets / local env (never commit)
# ---------------------------
.env
.env.*
!.env.example
*.key
.claude/settings.local.json

# ---------------------------
# Local-only artifacts (not for git)
# ---------------------------
Miniconda3-*.sh
*.mp4
# per-run configs generated by `gssg-run new` (inline comments are NOT allowed on a
# gitignore pattern line — they become part of the pattern and silently break the rule)
configs/_runs/
# Local scratch notes — may hold host credentials, never commit.
# Anything *.local.md is paired with a tracked file (e.g. docs/WORKLOG.local.md
# next to docs/WORKLOG.md) and holds the parts that must not be published.
*.local.md

# Ultralytics auto-downloads YOLOE weights to CWD; keep them out of the repo
yoloe-*.pt

